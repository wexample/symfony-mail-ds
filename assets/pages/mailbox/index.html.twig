{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {#- Said loud: a visitor landing here must not take it for the product. -#}
    {{ message_warning('@page::dev.title', '@page::intro', { icon: 'ph:bold/code' }) }}

    <div class="toolbar">
        {%- set recipient_items = [{
            label: '@page::filter.all' | trans,
            href: path('mailbox_index'),
            checked: recipient is null,
            radio: true,
        }] -%}
        {%- for address in recipients -%}
            {%- set recipient_items = recipient_items | merge([{
                label: address,
                href: path('mailbox_index', { to: address }),
                checked: address == recipient,
                radio: true,
            }]) -%}
        {%- endfor -%}
        {{ button_menu('ph:bold/funnel', recipient ?? '@page::filter.all' | trans, recipient_items, {
            class: 'button--flat' ~ (recipient ? ' is-active'),
        }) }}

        {%- if mails is not empty -%}
            <form class="align-right" method="post" action="{{ path('mailbox_purge') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('mailbox_purge') }}">
                {{ button('ph:bold/trash', '@page::action.purge' | trans, { type: 'submit', class: 'button--flat' }) }}
            </form>
        {%- endif -%}
    </div>

    {%- if mails is empty -%}
        <div class="block block--padded empty">{{ '@page::empty' | trans }}</div>
    {%- else -%}
        <div class="zone zone--split mailbox">
            <div class="zone zone--narrow zone--size-6 zone--scrollable list-expanded">
                <div class="list-expanded--items">
                    {%- for mail in mails -%}
                        {{ bar(mail.subject ?? '@page::no_subject' | trans, {
                            icon: mail.attachments is empty ? 'ph:bold/envelope-simple' : 'ph:bold/paperclip',
                            subtitle: mail.recipients | join(', '),
                            meta: date_display(mail.date, 'date_time_short'),
                            href: path('mailbox_index', { id: mail.id, to: recipient }),
                            class: 'list-expanded--item',
                            attr: {
                                'data-list-expanded-item': '',
                                'aria-current': selected and selected.id == mail.id ? 'true' : null,
                            },
                        }) }}
                    {%- endfor -%}
                </div>
            </div>

            <div class="zone zone--scrollable">
                {%- if selected -%}
                    <section class="block block--card">
                        <div class="block--title">
                            <span class="block--title-label">{{ selected.subject ?? '@page::no_subject' | trans }}</span>
                        </div>
                        <div class="block--body stack--vertical">
                            {%- set headers = [
                                { key: '@page::field.from' | trans, value: selected.from | join(', ') },
                                { key: '@page::field.to' | trans, value: selected.to | join(', ') },
                            ] -%}
                            {%- if selected.cc is not empty -%}
                                {%- set headers = headers | merge([{ key: '@page::field.cc' | trans, value: selected.cc | join(', ') }]) -%}
                            {%- endif -%}
                            {%- set headers = headers | merge([
                                { key: '@page::field.delivered_to' | trans, value: selected.recipients | join(', ') },
                                { key: '@page::field.date' | trans, value: date_display(selected.date, 'date_time_short'), html: true },
                            ]) -%}
                            {{ properties(headers, { compact: true }) }}

                            {%- if selected.html is not null -%}
                                {#- Served apart, sandboxed: see MailboxController::html(). -#}
                                <div class="mailbox--body">
                                    {{ document_embed(path('mailbox_html', { id: selected.id }), selected.subject ?? '', { loading: 'eager' }) }}
                                </div>
                            {%- elseif selected.text is not null -%}
                                <pre class="mailbox--text">{{ selected.text }}</pre>
                            {%- endif -%}

                            {%- if selected.links is not empty -%}
                                <h3>{{ '@page::field.links' | trans }}</h3>
                                <ul class="mailbox--links">
                                    {%- for link in selected.links -%}
                                        <li>{{ text_link(link, link, { external: true }) }}</li>
                                    {%- endfor -%}
                                </ul>
                            {%- endif -%}

                            {%- if selected.attachments is not empty -%}
                                <h3>{{ '@page::field.attachments' | trans }}</h3>
                                <div class="stack--vertical">
                                    {%- for attachment in selected.attachments -%}
                                        {{ bar(attachment.name ?? '@page::no_name' | trans, {
                                            icon: 'ph:bold/paperclip',
                                            subtitle: attachment.content_type,
                                            trailing: attachment.size | file_bytes,
                                        }) }}
                                    {%- endfor -%}
                                </div>
                            {%- endif -%}
                        </div>
                        <div class="block--footer">
                            <span></span>
                            {{ button_link('ph:bold/download-simple', '@page::action.raw' | trans, path('mailbox_raw', { id: selected.id }), { class: 'button--flat' }) }}
                        </div>
                    </section>
                {%- else -%}
                    <div class="block block--padded empty">{{ '@page::not_found' | trans }}</div>
                {%- endif -%}
            </div>
        </div>
    {%- endif -%}
{%- endblock -%}
