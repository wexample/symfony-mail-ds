{
  "name": "wexample/symfony-mail-ds",
  "description": "Design-system screens for symfony-mail: the development mailbox",
  "version": "2.1.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMailDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=31.0.0",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=21.0.0",
    "wexample/symfony-mail": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}